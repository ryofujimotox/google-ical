# 形式・振る舞いの正本: AGENTS.md（変数名の正本: 本ファイル）
# 値だけ書き換える。パス・タイムゾーン等の固定値は google_ical/config.py を編集

# auth / sync_calendar: OAuth 2.0 Client ID（必須）
#   設定する値 … 123456789-xxxxx.apps.googleusercontent.com 形式の文字列
#   取得 … Cloud Console → API とサービス → 認証情報 → OAuth 2.0 クライアント ID を作成（種類: デスクトップアプリ）
#   Calendar API を先に有効化: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
#   認証情報: https://console.cloud.google.com/apis/credentials
#   参考: https://developers.google.com/calendar/api/guides/auth
GOOGLE_CLIENT_ID=

# auth / sync_calendar: 上記 OAuth クライアントの Client secret（必須）
#   設定する値 … GOCSPX- で始まる文字列（GOOGLE_CLIENT_ID と同じクライアントの secret）
#   作成直後にしか表示されない。紛失したら認証情報画面で再生成
GOOGLE_CLIENT_SECRET=

# auth: 1 / true / yes / on で「認可コード入力」フロー（任意）
#   通常 … 実行マシンのブラウザが自動で開く
#   1 … ターミナルに Google の認可 URL が出る → 手元 PC 等のブラウザで開いてログイン → 表示された認可コードをターミナルへ貼る
#   SSH 接続中は未設定でも自動で 1 相当になることが多い
#   認可成功後のトークンは data/auth/token.json に保存（パスは config.py 固定）
GOOGLE_ICAL_OAUTH_CONSOLE=

# sync_calendar: 書き込み先の Google カレンダー ID（必須）
#   iCal 公開 URL ではない。Calendar API 用（primary や xxx@group.calendar.google.com）
#   data/ical_jsons/*.json の iCalJSON をここへ作成・更新・削除する
#   取得 … カレンダー設定 → カレンダーの統合 → カレンダー ID。公開すると iCal で購読可
GOOGLE_CALENDAR_ID=

# fetch_gomi: ゴミ収集日 PDF の URL を直接指定（任意）
#   空 … ChatGPT に GOMI_REGION を渡して公式 PDF の URL を調査する
#   URL 指定 … 調査をスキップし、この URL から PDF をダウンロードする
#   自治体 PDF の場所が固定で、毎月 URL 探索を省きたいとき向け
GOMI_PDF_URL_OVERRIDE=

# fetch_gomi: 自治体名（1件）。GOMI_PDF_URL_OVERRIDE 未指定時のみ必須
#   例: 東京都〇〇区
GOMI_REGION=

# fetch_gomi: OpenAI API キー
OPENAI_API_KEY=

# fetch_gomi: ChatGPT モデル名（例: gpt-4.1-mini）
OPENAI_MODEL=gpt-4.1-mini
