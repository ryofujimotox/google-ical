# Google Calendar API のサービスアカウント JSON パス
GOOGLE_SERVICE_ACCOUNT_FILE=/home/scripts/google-ical/service-account.json

# 更新先カレンダー ID（例: xxx@group.calendar.google.com）
GOOGLE_CALENDAR_ID=primary

# 固定予定 JSON。複数はカンマ区切り
EVENT_JSON_PATHS=/home/scripts/google-ical/events.json

# ゴミ収集カレンダー PDF。URL またはローカルパス。空ならゴミ予定は取り込まない
GOMI_PDF_SOURCES=

# ゴミPDFから予定を生成する年。空なら今日の年
GOMI_YEAR=

# 同期対象期間。空なら今日から 180 日
SYNC_DAYS=180

# Google Calendar 上でこのバッチが作った予定だけを識別する名前空間
SYNC_NAMESPACE=google-ical
